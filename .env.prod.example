# Copy to .env.prod on the VPS and fill in real values.
# This template is safe to commit — it holds no secrets.

# --- Django -----------------------------------------------------------
DJANGO_SETTINGS_MODULE=config.settings.production
# Generate: python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=dzleadsfinder.akrambensouici.com

# --- PostgreSQL -------------------------------------------------------
POSTGRES_DB=dzleads
POSTGRES_USER=dzleads
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# --- Redis ------------------------------------------------------------
REDIS_URL=redis://redis:6379/0

# --- Public site ------------------------------------------------------
# Drives password-reset/verification links and Chargily return URLs —
# no code depends on any hostname other than this value.
FRONTEND_PUBLIC_URL=https://dzleadsfinder.akrambensouici.com
# The From domain must be DKIM/SPF-verified in Resend (3 DNS records).
DEFAULT_FROM_EMAIL=DzLeadsFinder <dzleadsfinder@akrambensouici.com>

# --- Email (Resend SMTP) ----------------------------------------------
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.resend.com
EMAIL_PORT=587
EMAIL_HOST_USER=resend
EMAIL_HOST_PASSWORD=re_XXXXXXXXXX-your-resend-api-key
EMAIL_USE_TLS=true

# --- Chargily — TEST account for the first deployment -----------------
# Copy the API key + webhook secret from the Chargily TEST dashboard.
# Register the webhook URL there: https://dzleadsfinder.akrambensouici.com/api/webhooks/chargily/
CHARGILY_API_KEY=test_api_key
CHARGILY_WEBHOOK_SECRET=test_whsec
CHARGILY_MODE=test